%{
#include "y.tab.h"
extern yylval;
%}

%%
[0-9]+       { yylval = atoi(yytext); return NUMBER; }
[a-zA-Z]     { return ID; }
[ \t]+        ;
\n            { return 0; }
.             { return yytext[0]; }
%%

yacc.file
%{
#include <stdio.h>
%}

%token NUMBER ID

%%

E : E '+' T     { $$ = $1 + $3; }
  | E '-' T     { $$ = $1 - $3; }
  | T           { $$ = $1; }
  ;

T : T '*' F     { $$ = $1 * $3; }
  | T '/' F     { $$ = $1 / $3; }
  | F           { $$ = $1; }
  ;

F : '(' E ')'   { $$ = $2; }
  | NUMBER      { $$ = $1; }
  | ID          { $$ = $1; }
  ;

%%

int main()
{
    printf("Enter the expression\n");
    yyparse();
}

int yyerror(char *s)
{
    printf("\nExpression is invalid\n");
}
