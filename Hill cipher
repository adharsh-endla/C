import java.util.Scanner;

public class HillCipher {

    static int[][] keyMatrix = {
        {6, 24, 1},
        {13, 16, 10},
        {20, 17, 15}
    }; // Invertible modulo 26

    static int[][] inverseKeyMatrix;

    // Convert character to int (A=0,...,Z=25)
    static int charToInt(char c) {
        return c - 'A';
    }

    // Convert int to character
    static char intToChar(int i) {
        return (char) (i + 'A');
    }

    // Multiply matrix with vector and mod 26
    static int[] multiply(int[][] matrix, int[] vector) {
        int[] result = new int[3];

        for (int i = 0; i < 3; i++) {
            result[i] = 0;

            for (int j = 0; j < 3; j++) {
                result[i] += matrix[i][j] * vector[j];
            }

            result[i] %= 26;
        }

        return result;
    }

    // Find modular inverse of determinant
    static int modInverse(int a, int m) {
        a = a % m;

        for (int x = 1; x < m; x++)
            if ((a * x) % m == 1)
                return x;

        return -1;
    }

    // Find determinant of 3x3 matrix mod 26
    static int determinant(int[][] matrix) {
        int det = matrix[0][0] *
                (matrix[1][1] * matrix[2][2] -
                 matrix[1][2] * matrix[2][1])
                - matrix[0][1] *
                (matrix[1][0] * matrix[2][2] -
                 matrix[1][2] * matrix[2][0])
                + matrix[0][2] *
                (matrix[1][0] * matrix[2][1] -
                 matrix[1][1] * matrix[2][0]);

        det = det % 26;

        if (det < 0)
            det += 26;

        return det;
    }

    // Get cofactor of 3x3 matrix
    static int[][] cofactorMatrix(int[][] matrix) {
        int[][] cofactor = new int[3][3];

        cofactor[0][0] =
            (matrix[1][1] * matrix[2][2] -
             matrix[1][2] * matrix[2][1]) % 26;

        cofactor[0][1] =
            -(matrix[1][0] * matrix[2][2] -
              matrix[1][2] * matrix[2][0]) % 26;

        cofactor[0][2] =
            (matrix[1][0] * matrix[2][1] -
             matrix[1][1] * matrix[2][0]) % 26;

        cofactor[1][0] =
            -(matrix[0][1] * matrix[2][2] -
              matrix[0][2] * matrix[2][1]) % 26;

        cofactor[1][1] =
            (matrix[0][0] * matrix[2][2] -
             matrix[0][2] * matrix[2][0]) % 26;

        cofactor[1][2] =
            -(matrix[0][0] * matrix[2][1] -
              matrix[0][1] * matrix[2][0]) % 26;

        cofactor[2][0] =
            (matrix[0][1] * matrix[1][2] -
             matrix[0][2] * matrix[1][1]) % 26;

        cofactor[2][1] =
            -(matrix[0][0] * matrix[1][2] -
              matrix[0][2] * matrix[1][0]) % 26;

        cofactor[2][2] =
            (matrix[0][0] * matrix[1][1] -
             matrix[0][1] * matrix[1][0]) % 26;

        for (int i = 0; i < 3; i++)
            for (int j = 0; j < 3; j++) {
                cofactor[i][j] = cofactor[i][j] % 26;

                if (cofactor[i][j] < 0)
                    cofactor[i][j] += 26;
            }

        return cofactor;
    }

    // Transpose matrix
    static int[][] transpose(int[][] matrix) {
        int[][] transposed = new int[3][3];

        for (int i = 0; i < 3; i++)
            for (int j = 0; j < 3; j++)
                transposed[i][j] = matrix[j][i];

        return transposed;
    }

    // Inverse of 3x3 matrix mod 26
    static int[][] inverseMatrix(int[][] matrix) {
        int det = determinant(matrix);
        int invDet = modInverse(det, 26);

        if (invDet == -1) {
            throw new IllegalArgumentException(
                "Matrix is not invertible modulo 26.");
        }

        int[][] cofactor = cofactorMatrix(matrix);
        int[][] adjugate = transpose(cofactor);
        int[][] inverse = new int[3][3];

        for (int i = 0; i < 3; i++)
            for (int j = 0; j < 3; j++) {
                inverse[i][j] =
                    (adjugate[i][j] * invDet) % 26;

                if (inverse[i][j] < 0)
                    inverse[i][j] += 26;
            }

        return inverse;
    }

    // Encrypt the plaintext using Hill cipher
    static String encrypt(String plaintext) {
        plaintext = plaintext.toUpperCase()
                             .replaceAll("[^A-Z]", "");

        // Pad with X to multiple of 3
        while (plaintext.length() % 3 != 0) {
            plaintext += "X";
        }

        StringBuilder ciphertext = new StringBuilder();

        for (int i = 0; i < plaintext.length(); i += 3) {
            int[] block = {
                charToInt(plaintext.charAt(i)),
                charToInt(plaintext.charAt(i + 1)),
                charToInt(plaintext.charAt(i + 2))
            };

            int[] encryptedBlock = multiply(keyMatrix, block);

            for (int val : encryptedBlock) {
                ciphertext.append(intToChar(val));
            }
        }

        return ciphertext.toString();
    }

    // Decrypt the ciphertext using Hill cipher
    static String decrypt(String ciphertext) {
        ciphertext = ciphertext.toUpperCase()
                               .replaceAll("[^A-Z]", "");

        if (inverseKeyMatrix == null) {
            inverseKeyMatrix = inverseMatrix(keyMatrix);
        }

        StringBuilder plaintext = new StringBuilder();

        for (int i = 0; i < ciphertext.length(); i += 3) {
            int[] block = {
                charToInt(ciphertext.charAt(i)),
                charToInt(ciphertext.charAt(i + 1)),
                charToInt(ciphertext.charAt(i + 2))
            };

            int[] decryptedBlock =
                multiply(inverseKeyMatrix, block);

            for (int val : decryptedBlock) {
                plaintext.append(intToChar(val));
            }
        }

        return plaintext.toString();
    }

    // Main method
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter plaintext: ");
        String input = scanner.nextLine();

        String encrypted = encrypt(input);
        System.out.println("Encrypted Text: " + encrypted);

        String decrypted = decrypt(encrypted);
        System.out.println("Decrypted Text: " + decrypted);
    }
}
