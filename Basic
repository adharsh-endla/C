3. Swap Two Numbers (Using Temporary Variable)
#include <stdio.h>

int main() {
    int a = 5, b = 10, temp;

    temp = a;
    a = b;
    b = temp;

    printf("a = %d\n", a);
    printf("b = %d", b);

    return 0;
}

Output:

a = 10
b = 5


